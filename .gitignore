# Ignore rules for DB2CRUD.
# Based on the shared rules of the personal_web_style tools (Model2DB, Mapper),
# extended with the build outputs of the generated projects (Java / JVM) and with
# exceptions for the whole generated projects kept in shared/test-cases/.

# ==============================
# Local working files (notes, plans, sample models): never versioned
# ==============================
**/local-data/

# ==============================
# AI assistants / agents
# ==============================
.claude/
CLAUDE.md
CLAUDE.local.md
AGENTS.md
.cursor/
.cursorrules
.cursorignore
.windsurf/
.windsurfrules
.codeium/
.continue/
.aider*
.copilot/
.github/copilot-instructions.md
.gemini/
GEMINI.md
.codex/
.cline/
.clinerules
.roo/
.roomodes
.tabnine/
.zed/

# ==============================
# Node / React / TypeScript
# ==============================
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.npm/
.pnpm-store/

# Builds
dist/
build/
out/
.vite/
vite.config.js.timestamp-*
vite.config.ts.timestamp-*
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log
logs/

# Tests / coverage
coverage/
.nyc_output/
playwright-report/
test-results/
blob-report/

# Caches
.eslintcache
.stylelintcache
.cache/

# ==============================
# Python
# ==============================
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environments
.venv/
venv/
env/
ENV/
.python-version

# Packaging
*.egg-info/
*.egg
.eggs/
wheels/
sdist/

# PyInstaller
*.manifest

# Tests / types / linters
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.hypothesis/

# Local databases created when running generated projects
*.sqlite3
*.db

# ==============================
# Java / JVM (generated Spring Boot and Ktor projects)
# ==============================
target/
.gradle/
*.class
*.jar
!**/gradle/wrapper/gradle-wrapper.jar
hs_err_pid*

# ==============================
# Verification of generated projects
# ==============================
# Projects written by the verification scripts are rebuilt on every run.
verification/.work/

# ==============================
# Environment variables and secrets
# ==============================
.env
.env.*
!.env.example
*.pem
*.key

# ==============================
# Editors / IDEs
# ==============================
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
.idea/
*.iml
*.swp
*.swo
*~

# ==============================
# Operating systems
# ==============================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
.fseventsd
.TemporaryItems
Icon?

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
desktop.ini
$RECYCLE.BIN/

# Linux
.directory
.Trash-*
.nfs*

# ==============================
# Shared test cases
# ==============================
# They hold whole generated projects, files that look like local ones included (Laravel logs, Symfony .env).
!shared/test-cases/outputs/**/logs/
!shared/test-cases/outputs/**/.env
!shared/test-cases/outputs/**/.env.*
